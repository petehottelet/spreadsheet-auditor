{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Spreadsheet Auditor Config",
  "description": "The auditor rejects, with exit code 4, a config holding a section, setting or rule it does not know, or a value of the wrong type.",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "mode": { "type": "string" },
    "scope": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "include_sheets": { "type": "array", "items": { "type": "string" } },
        "exclude_sheets": { "type": "array", "items": { "type": "string" } },
        "headline_outputs": { "type": "array", "items": { "type": "string" } }
      }
    },
    "materiality": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "absolute": { "type": "number" },
        "relative": { "type": "number" },
        "percent_points": { "type": "number" }
      }
    },
    "limits": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "max_cells": { "type": "integer", "minimum": 0 },
        "max_formulas": { "type": "integer", "minimum": 0 },
        "max_range_expansion_cells": { "type": "integer", "minimum": 0 },
        "max_reported_findings": { "type": "integer", "minimum": 0 },
        "timeout_seconds": { "type": "integer", "minimum": 0 }
      }
    },
    "suppressions": {
      "type": "array",
      "items": {
        "type": "object",
        "anyOf": [
          { "required": ["rule_id", "range", "reason"] },
          { "required": ["fingerprint", "reason"] }
        ],
        "properties": {
          "rule_id": { "type": "string" },
          "range": { "type": "string" },
          "fingerprint": {
            "type": "string",
            "description": "The finding's fingerprint. With rule_id and range, it pins the suppression to that finding: the fingerprint decides the match, and range documents where the finding was accepted."
          },
          "reason": { "type": "string" },
          "expiry": { "type": "string" },
          "owner": { "type": "string" }
        }
      }
    },
    "checks": {
      "type": "object",
      "description": "Rule ID (such as LIVE_ERROR) or its lowercase alias (such as live_errors) to setting. Names and settings match in any case; true means error and false means off.",
      "additionalProperties": {
        "oneOf": [
          {
            "type": "string",
            "enum": ["error", "on", "true", "warn", "warning", "review", "off", "false", "disabled", "disable"]
          },
          { "type": "boolean" }
        ]
      }
    },
    "recalc": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "enabled": { "type": "boolean" },
        "timeout_seconds": { "type": "integer", "minimum": 1 }
      }
    },
    "finance": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "enabled": { "type": "boolean" }
      }
    }
  }
}
